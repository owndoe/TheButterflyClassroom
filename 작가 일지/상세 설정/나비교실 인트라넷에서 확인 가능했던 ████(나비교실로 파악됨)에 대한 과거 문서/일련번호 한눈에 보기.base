views:
  - type: table
    name: 표
    filters:
      and:
        - file.folder == "TheButterflyClassroom/작가 일지/상세 설정/나비교실 인트라넷에서 확인 가능했던 ████(나비교실로 파악됨)에 대한 과거 문서"
    order:
      - file.name
      - 문서 번호
      - tags
    sort:
      - property: 문서 번호
        direction: ASC
      - property: file.tags
        direction: DESC
